# Values of a full run. Filled values are decided, with their source in docs/decisions.md; empty
# ones are still open there, and full.sbatch stops at the first one left unset.
# ARCH_ARGS is (--channels <w1> <w2> ...) for convnet and empty for unet, whose encoder is fixed.
ARCH=
ARCH_ARGS=()
# unet only, and required: none, imagenet or sentinel2_moco. Leave empty for convnet.
ENCODER_WEIGHTS=
# One directory per variant and fraction, such as runs/unet_scratch-f0.01 or runs/convnet-f1.0.
RUN_DIR=
# Share of the training tiles: 0.01, 0.05, 0.10 or 1.0. Validation, calibration and test stay whole.
TRAIN_FRACTION=
# The versioned lists' seed, so the fractions stay nested and nothing is regenerated.
SUBSET_SEED=0
# Every run shares EPOCHS and STEPS_PER_EPOCH, so every fraction gets the same updates.
EPOCHS=100
STEPS_PER_EPOCH=250
BATCH_SIZE=16
# Every stage after training; changing it after an OOM refuses nothing and retrains nothing.
EVAL_BATCH_SIZE=
LR=1e-4
WEIGHT_DECAY=0.01
LOSS=dice_bce
SEED=0

# LAYERS are swept on the validation role; the job calibrates the one with the highest explained
# variance among those ascending, in both directions, on at least MIN_FRACTION_ASCENDING of the
# swept cells. The paper sets no threshold; choose it from the pilot (docs/decisions.md).
LAYERS=()
MIN_FRACTION_ASCENDING=
SVM_C=
SVM_CLASS_WEIGHT=
SVM_PIXELS_PER_CELL=
SWEEP_STEPS=
SWEEP_CELLS=
BETA_RANGE_LOGITS=100
BETA_RANGE_FEATURES=1000
DIRECTION_TEMPERATURE=
SEARCH_THRESHOLD_LOGITS=1e-2
SEARCH_THRESHOLD_FEATURES=
CELLS=all
SCORE_FLOOR_HA=
# 0.75% of a 512-pixel cell's diagonal.
BOUNDARY_TOLERANCE_PX=5.43
