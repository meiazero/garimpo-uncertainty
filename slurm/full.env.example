# Values of a full run. Empty on purpose: full.sbatch stops at the first one left unset.
# ARCH_ARGS is (--channels <w1> <w2> ...) for convnet and empty for unet, whose encoder is fixed.
ARCH=
ARCH_ARGS=()
# unet only, and required: none, imagenet or sentinel2_moco. Leave empty for convnet.
ENCODER_WEIGHTS=
# One directory per variant and fraction, such as runs/unet_scratch-f0.01 or runs/convnet-f1.0.
RUN_DIR=
# Share of the training tiles: 0.01, 0.05, 0.10 or 1.0. Validation, calibration and test stay whole.
TRAIN_FRACTION=
# Picks the training tiles, apart from SEED; keep one value so the fractions stay nested. Use the
# subset_seed of the versioned lists. validate_data stops on another seed only if its tiles are not
# downloaded: after the 100% list every selection is present, so nothing checks the seed.
SUBSET_SEED=
# Per run: fixed epochs versus fixed updates across fractions is still undecided.
EPOCHS=
BATCH_SIZE=
# Every stage after training; changing it after an OOM refuses nothing and retrains nothing.
EVAL_BATCH_SIZE=
LR=
WEIGHT_DECAY=
LOSS=
SEED=

# LAYERS are swept on the validation role; LAYER, one of them, is the one calibrated.
# First submit with STOP_AFTER_DIAGNOSTICS=1 and LAYER empty; choose; then fill LAYER, clear the flag.
STOP_AFTER_DIAGNOSTICS=
LAYER=
LAYERS=()
SVM_C=
SVM_CLASS_WEIGHT=
SVM_PIXELS_PER_CELL=
SWEEP_STEPS=
SWEEP_CELLS=
BETA_RANGE_LOGITS=
BETA_RANGE_FEATURES=
SEARCH_THRESHOLD_LOGITS=
SEARCH_THRESHOLD_FEATURES=
CELLS=
SCORE_FLOOR_HA=
BOUNDARY_TOLERANCE_PX=
